{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/google-sheet-save.js": {
      "maxDuration": 60
    },
    "api/google-sheet/[sheetId].js": {
      "maxDuration": 60
    },
    "api/sheet-version.js": {
      "maxDuration": 20
    }
  }
}
